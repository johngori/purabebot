{
  "name": "purabebot",
  "productName": "purabebot",
  "version": "2.3.0",
  "description": "My Electron application description",
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "keywords": [],
  "author": {
    "name": "johngori",
    "email": "johngori03@gmail.com"
  },
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "test007"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^7.0.0",
    "express": "^4.17.1",
    "node-cron": "^3.0.0",
    "semver": "^7.8.5",
    "socket.io": "^3.1.0",
    "tmi.js": "^1.7.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "productName": "purabebot",
    "appId": "johngori.purabebot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src",
      "package.json",
      "package-lock.json",
      ".env"
    ],
    "win": {
      "icon": "src/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}